# MongoDB / Prisma
DATABASE_URL=mongodb://...

# Google OAuth token verification
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Server
PORT=9000
SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret

# Frontend App URL (for reset links)
CLIENT_URL=http://localhost:3000

# Brevo HTTP API (Recommended for production / Render)
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-email@gmail.com
BREVO_SENDER_NAME="Hulu Track"

# SMTP Fallback (e.g. Gmail App Password for local dev)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
