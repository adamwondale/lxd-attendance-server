generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String           @unique
  timezone       String           @default("Africa/Addis_Ababa")
  companyEmail   String?
  companyPhone   String?
  adminName      String?
  cohorts   Cohort[]
  users     UserTenantRole[]
}

model User {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  email       String             @unique 
  password    String?
  oauthId     String?
  name        String
  phone       String?
  username    String?
  tenants     UserTenantRole[]
  cohorts     CohortMembership[]
  attendance  AttendanceLog[]
  penalties   Penalty[]
}

model UserTenantRole {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  userId   String @db.ObjectId
  tenantId String @db.ObjectId
  role     String // "STUDENT" | "COORDINATOR" | "SUPER_ADMIN"
  user     User   @relation(fields: [userId], references: [id])
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  @@unique([userId, tenantId])
}

model Cohort {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  tenantId           String             @db.ObjectId
  name               String
  pin                String             @unique
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean            @default(true)
  durationMonths     Int?
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  sessions           CohortSession[]
  memberships        CohortMembership[] 
}

model CohortMembership {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cohortId  String   @db.ObjectId
  userId    String   @db.ObjectId
  sessionId String?  @db.ObjectId
  joinedAt  DateTime @default(now())
  status    String   @default("ACTIVE") // "ACTIVE" | "EXPIRED"
  cohort    Cohort   @relation(fields: [cohortId], references: [id])
  session   CohortSession? @relation(fields: [sessionId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  @@unique([cohortId, userId]) 
}

model CohortSession {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  cohortId           String          @db.ObjectId
  name               String          
  startTime          String          // e.g., "09:00" (Local to Tenant TZ)
  gracePeriodMinutes Int             // e.g., 5
  recurrenceDays     String[]        // e.g., ["MON", "TUE"] or ["EVERYDAY"]
  latePenaltyAmount  Int             @default(25)
  escalationThresholdMinutes Int     @default(15)
  escalationRate             Int     @default(5)
  escalationIntervalMinutes  Int     @default(5)
  cohort             Cohort          @relation(fields: [cohortId], references: [id])
  logs               AttendanceLog[]
  memberships        CohortMembership[]
}

model AttendanceLog {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String        @db.ObjectId
  userId    String        @db.ObjectId
  date      String        // e.g. "2026-08-29"
  scannedAt DateTime      @default(now())
  isLate    Boolean       @default(false)
  latenessMinutes Int      @default(0)
  calculatedPenalty Int    @default(0)
  deviceSignature String?
  isManualScan Boolean      @default(false)
  session   CohortSession @relation(fields: [sessionId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  penalty   Penalty?      
  @@unique([sessionId, userId, date]) // Idempotency lock
  @@index([deviceSignature, scannedAt])
}

model Penalty {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId
  attendanceLogId String        @unique @db.ObjectId  
  amount          Int           @default(25) 
  status          String        @default("UNPAID")
  waiverReason    String?
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id])
  attendanceLog   AttendanceLog @relation(fields: [attendanceLogId], references: [id])
}

model DeviceLock {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  signature  String   @unique
  lockedUntil DateTime
  updatedAt  DateTime @updatedAt
}
