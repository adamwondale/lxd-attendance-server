{
  "version": 2,
  "builds": [
    {
      "src": "dist/main.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "dist/**",
          "prisma/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/graphql",
      "dest": "dist/main.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "dist/main.js"
    }
  ]
}
